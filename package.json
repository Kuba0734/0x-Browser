{
  "name": "0x-browser",
  "productName": "0x Browser",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal, performance-focused desktop browser",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc && electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^44.9.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
